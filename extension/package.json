{
  "name": "kapowie",
  "version": "0.1.0",
  "description": "Live stream recorder & re-streamer Chrome extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "type-check": "tsc --noEmit -p ./tsconfig.json",
    "lint": "npm run check && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "idb": "^8.0.0",
    "mux.js": "^7.1.0",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "jsdom": "^25.0.1",
    "svelte-check": "^4.1.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9",
    "wxt": "^0.20.27"
  }
}
